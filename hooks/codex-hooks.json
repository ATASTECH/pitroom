{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v pitroom >/dev/null 2>&1 && pitroom hook-start || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v pitroom >/dev/null 2>&1 && pitroom hook-card || true'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
