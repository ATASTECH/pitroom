{
  "name": "pitroom",
  "version": "0.16.0",
  "mcpName": "io.github.ATASTECH/pitroom",
  "description": "A free pit crew for your expensive coding agent: the superpowers development workflow, run by cheap workers. Delegate research, fixes, tests, reviews and whole plans from Claude Code, Codex or any agent to OpenCode, Codex, Claude Code or Gemini CLI workers, with receipts that prove the savings.",
  "type": "module",
  "author": "TahaAtas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATASTECH/pitroom.git"
  },
  "homepage": "https://github.com/ATASTECH/pitroom#readme",
  "bugs": {
    "url": "https://github.com/ATASTECH/pitroom/issues"
  },
  "bin": {
    "pitroom": "bin/pitroom.cjs"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "hooks",
    "policies",
    ".claude-plugin",
    ".codex-plugin",
    "gemini-extension.json",
    "gemini-context.md",
    "assets",
    "docs/backends.md",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "bump": "node scripts/bump-version.mjs"
  },
  "keywords": [
    "agent",
