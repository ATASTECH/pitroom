    "planning",
    "subagent",
    "tdd",
    "tokens",
    "workflow"
  ],
  "license": "MIT",
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@pierre/diffs": "^1.5.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  }
