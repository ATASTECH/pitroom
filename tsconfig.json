{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@/*": [
        "./ui/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
